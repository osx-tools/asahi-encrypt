#!/bin/bash

script=${0%/*}/../bin/asahi-encrypt
readme=${0%/*}/../README.md

which gsed >/dev/null && SED=gsed || SED=sed

# This updates the USAGE section of README with the
# output of `asahi-encrypt -h` (usage help):

$SED -ri '
/^# USAGE/,/^#/ {
    /^#/!d
    /^# USAGE/ {
        p
        s|.*|'"'$script' -h"'|e
        s|.*|\n``` ini\n&\n```\n|
    }
}' "$readme"

